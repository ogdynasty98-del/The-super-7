name: JEDI-AI CI Core Pipeline

on:
  # Allows manual triggering from the GitHub Actions UI, API, or web apps
  workflow_dispatch:
    inputs:
      reason:
        description: 'Reason for manual trigger'
        required: false
        default: 'Manual execution'

  # Allows remote execution via external API events
  repository_dispatch:
    types: [run-all, trigger-ci, build-event]

  # Triggers automatically on code pushes to any branch
  push:
    branches:
      - '**'

  # Triggers on open, sync, or reopened pull requests to any branch
  pull_request:
    branches:
      - '**'

jobs:
  build-and-test:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python Environment
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

      - name: Execute Main Pipeline Script
        run: |
          echo "Workflow dispatched successfully."
          python -c "print('Pipeline execution active and responsive.')"